{
  "name": "@barbershop-v2/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"['dist','tsconfig.tsbuildinfo'].forEach(p=>{try{require('fs').rmSync(p,{recursive:true,force:true})}catch(e){}})\"",
    "build": "npm run clean && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@expo-google-fonts/frank-ruhl-libre": "^0.4.1",
    "@expo-google-fonts/noto-sans-arabic": "^0.4.1",
    "@expo-google-fonts/noto-sans-hebrew": "^0.4.1",
    "@expo-google-fonts/rubik": "^0.4.2",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^17.3.1",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "ajv": ">=8.18.0",
    "file-type": ">=21.3.2",
    "path-to-regexp": "8.4.0",
    "picomatch": "4.0.4"
  }
}
